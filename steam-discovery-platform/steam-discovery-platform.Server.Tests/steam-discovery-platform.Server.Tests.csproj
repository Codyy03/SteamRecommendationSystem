  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\steam-discovery-platform.Server\steam-discovery-platform.Server.csproj" />
  </ItemGroup>

</Project>
